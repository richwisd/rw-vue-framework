{
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "workspaces": [
    "packages/*",
    "play",
    "docs"
  ],
  "keywords": [],
  "license": "ISC",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yourusername/your-repo.git"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "pnpm -C play dev",
    "test:coverage": "vitest --coverage",
    "test:ssr": "vitest --config ./ssr-testing/vitest.config.ts",
    "prepare:e2e": "if [ ! -d \"docs/.vitepress/dist\" ]; then pnpm run docs:build; fi;",
    "gen": "bash ./scripts/gc.sh",
    "gen:version": "tsx scripts/gen-version.ts",
    "diff:table": "tsx scripts/build-table.ts",
    "update:version": "tsx scripts/update-version.ts",
    "clean": "pnpm run clean:dist && pnpm run -r --parallel clean",
    "clean:dist": "rimraf dist",
    "build": "pnpm run -C internal/build start",
    "format": "prettier --write --cache .",
    "lint": "eslint . --ext .vue,.js,.ts,.jsx,.tsx,.md,.json --max-warnings 0 --cache",
    "lint:fix": "pnpm run lint --fix",
    "lint:commit": "commitlint --from $(git merge-base origin/dev HEAD) --to HEAD > ./commit-lint.txt",
    "typecheck": "run-p typecheck:web typecheck:play typecheck:node typecheck:vite-config typecheck:vitest",
    "typecheck:web": "vue-tsc -p tsconfig.web.json --composite false --noEmit",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:play": "vue-tsc -p tsconfig.play.json --composite false --noEmit",
    "typecheck:vite-config": "vue-tsc -p tsconfig.vite-config.json --composite false --noEmit",
    "typecheck:vitest": "vue-tsc -p tsconfig.vitest.json --composite false --noEmit",
    "docs:dev": "pnpm run -C docs dev",
    "docs:build": "pnpm run -C docs build",
    "docs:serve": "pnpm run -C docs serve",
    "docs:gen-locale": "pnpm run -C docs gen-locale",
    "docs:crowdin-credentials": "pnpm run -C docs crowdin-credentials",
    "stub": "pnpm run -r --parallel stub",
    "clear:all": "npx rimraf node_modules 2>/dev/null || true && pnpm -r exec rimraf node_modules 2>/dev/null || true && npx rimraf pnpm-lock.yaml 2>/dev/null || true && pnpm -r exec rimraf pnpm-lock.yaml 2>/dev/null || true",
    "reinstall:all": "pnpm clear:all && pnpm install"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.6",
    "@popperjs/core": "npm:@sxzz/popperjs-es@^2.11.8",
    "@rw-vue-framework/constants": "workspace:*",
    "@rw-vue-framework/controls": "workspace:*",
    "@rw-vue-framework/directives": "workspace:*",
    "@rw-vue-framework/hooks": "workspace:*",
    "@rw-vue-framework/locale": "workspace:*",
    "@rw-vue-framework/router": "workspace:*",
    "@rw-vue-framework/stores": "workspace:*",
    "@rw-vue-framework/utils": "workspace:*",
    "@types/lodash": "^4.17.24",
    "@types/lodash-es": "^4.17.12",
    "@types/sortablejs": "^1.15.9",
    "@vueuse/core": "^14.2.1",
    "async-validator": "^4.2.5",
    "dayjs": "^1.11.20",
    "escape-html": "^1.0.3",
    "lodash": "^4.18.1",
    "lodash-es": "^4.18.1",
    "lodash-unified": "^1.0.3",
    "memoize-one": "^6.0.0",
    "normalize-wheel-es": "^1.2.0",
    "sortablejs": "^1.15.7"
  },
  "devDependencies": {
    "@ljharb/tsconfig": "^0.3.2",
    "@pnpm/find-workspace-packages": "^6.0.9",
    "@pnpm/logger": "^1001.0.1",
    "@pnpm/types": "^1001.3.0",
    "@rw-vue-framework/build": "workspace:^",
    "@rw-vue-framework/build-utils": "workspace:^",
    "@rw-vue-framework/eslint-config": "workspace:*",
    "@types/fs-extra": "^11.0.4",
    "@types/gulp": "^4.0.18",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^25.5.2",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitejs/plugin-vue-jsx": "^5.1.5",
    "@vitest/coverage-v8": "^4.1.3",
    "@vitest/ui": "^4.1.3",
    "@vue/test-utils": "^2.4.6",
    "czg": "^1.12.0",
    "element-plus": "^2.13.6",
    "eslint": "^10.2.0",
    "jsdom": "^29.0.2",
    "lodash-unified": "^1.0.3",
    "prettier": "^3.8.1",
    "resize-observer-polyfill": "^1.5.1",
    "rimraf": "^6.1.3",
    "sass": "^1.99.0",
    "typescript": "^6.0.2",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.0.0",
    "unplugin-vue-macros": "^2.14.5",
    "vite": "^8.0.8",
    "vitest": "^4.1.3",
    "vue": "^3.5.32",
    "vue-i18n": "^11.3.2"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=5"
  }
}
