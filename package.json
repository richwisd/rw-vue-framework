{
  "name": "rw-vue-framework",
  "type": "module",
  "version": "1.0.21",
  "description": "A Vue 3 component library with controls, utils, stores and more.",
  "author": "richwisd",
  "license": "MIT",
  "homepage": "https://www.richwisd.net",
  "repository": {
    "type": "git",
    "url": "https://gitee.com/richwisd/rw-vue-framework.git"
  },
  "bugs": {
    "url": "https://gitee.com/richwisd/rw-vue-framework/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "components",
    "ui",
    "library"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./constants": {
      "import": "./dist/constants.js",
      "require": "./dist/constants.cjs"
    },
    "./controls": {
      "import": "./dist/controls.js",
      "require": "./dist/controls.cjs"
    },
    "./hooks": {
      "import": "./dist/hooks.js",
      "require": "./dist/hooks.cjs"
    },
    "./icons": {
      "import": "./dist/icons.js",
      "require": "./dist/icons.cjs"
    },
    "./locale": {
      "import": "./dist/locale.js",
      "require": "./dist/locale.cjs"
    },
    "./pages": {
      "import": "./dist/pages.js",
      "require": "./dist/pages.cjs"
    },
    "./stores": {
      "import": "./dist/stores.js",
      "require": "./dist/stores.cjs"
    },
    "./utils": {
      "import": "./dist/utils.js",
      "require": "./dist/utils.cjs"
    },
    "./package.json": "./package.json",
    "./style.css": "./dist/style.css"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "play": "vite",
    "test": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "release": "bumpp",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-url": "^8.0.2",
    "@tsdown/css": "^0.21.7",
    "@types/crypto-js": "^4.2.2",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^25.5.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitest/browser-playwright": "^4.1.2",
    "bumpp": "^11.0.1",
    "playwright": "^1.58.2",
    "sass": "^1.99.0",
    "tsdown": "^0.21.7",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "vitest": "^4.1.2",
    "vitest-browser-vue": "^2.1.0",
    "vue": "^3.5.31",
    "vue-tsc": "^3.2.6"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@vue/shared": "^3.5.32",
    "@vueuse/core": "^14.2.1",
    "axios": "^1.15.0",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.20",
    "element-plus": "^2.13.6",
    "file-saver": "^2.0.5",
    "form-data": "^4.0.5",
    "js-cookie": "^3.0.5",
    "lodash-es": "^4.18.1",
    "lodash-unified": "^1.0.3",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "sortablejs": "^1.15.7",
    "vue-i18n": "^11.3.2",
    "xlsx": "^0.18.5"
  },
  "inlinedDependencies": {
    "@vue/reactivity": "3.5.32"
  }
}
