{
  "name": "rw-vue-framework",
  "type": "module",
  "version": "1.0.24",
  "description": "This is a rapid development framework based on Vue3 and Element Plus",
  "author": "richwisd",
  "license": "MIT",
  "homepage": "https://www.richwisd.com",
  "repository": {
    "type": "git",
    "url": "https://gitee.com/richwisd/rw-vue-framework.git"
  },
  "bugs": {
    "url": "https://gitee.com/richwisd/rw-vue-framework/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "framework",
    "element-plus",
    "element plus",
    "richwisd",
    "components",
    "ui",
    "library"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./constants": {
      "import": "./dist/constants.js",
      "require": "./dist/constants.cjs"
    },
    "./controls": {
      "import": "./dist/controls.js",
      "require": "./dist/controls.cjs"
    },
    "./hooks": {
      "import": "./dist/hooks.js",
      "require": "./dist/hooks.cjs"
    },
    "./icons": {
      "import": "./dist/icons.js",
      "require": "./dist/icons.cjs"
    },
    "./layout": {
      "import": "./dist/layout.js",
      "require": "./dist/layout.cjs"
    },
    "./locale": {
      "import": "./dist/locale.js",
      "require": "./dist/locale.cjs"
    },
    "./pages": {
      "import": "./dist/pages.js",
      "require": "./dist/pages.cjs"
    },
    "./stores": {
      "import": "./dist/stores.js",
      "require": "./dist/stores.cjs"
    },
    "./utils": {
      "import": "./dist/utils.js",
      "require": "./dist/utils.cjs"
    },
    "./package.json": "./package.json",
    "./style.css": "./dist/style.css"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --sourcemap",
    "play": "vite",
    "test": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "release": "bumpp",
    "prepublishOnly": "pnpm run build"
  },
    "engines": {
        "node": ">=24.12.0",
    "vue": ">=3.5.00"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-url": "^8.0.2",
    "@tsdown/css": "^0.22.3",
    "@types/crypto-js": "^4.2.2",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^26.1.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/browser-playwright": "^4.1.9",
    "bumpp": "^11.1.0",
    "playwright": "^1.61.1",
    "sass": "^1.101.0",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.9",
    "vue": "^3.5.39",
    "vue-tsc": "^3.3.6"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@vue/shared": "^3.5.39",
    "@vueuse/core": "^14.3.0",
    "axios": "^1.18.1",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.21",
    "element-plus": "^2.14.2",
    "file-saver": "^2.0.5",
    "form-data": "^4.0.6",
    "js-cookie": "^3.0.8",
    "lodash-es": "^4.18.1",
    "lodash-unified": "^1.0.3",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "screenfull": "^6.0.2",
    "sortablejs": "^1.15.7",
    "vue-i18n": "^11.4.6",
    "xlsx": "^0.18.5"
  },
  "inlinedDependencies": {
    "@vue/reactivity": "3.5.39"
  }
}
