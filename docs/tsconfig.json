{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "paths": {
      "rw-vue-framework": ["../packages/core"],
      "rw-vue-framework/*": ["../packages/core/*"]
    },
    "jsx": "preserve"
  },
  "include": [
    "**/*",
    ".vitepress/**/*"
  ],
  "exclude": [
    "node_modules"
  ]
}
